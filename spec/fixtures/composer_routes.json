{
  "about": [
    "Where a composer line goes: the cases ComposerRoute (both terminals) and the web's routeComposerLine (in a",
    "session) answer alike. spec/composer_route_spec.rb and spec/web/public/composer.test.js run every row.",
    "A row: text, running, images (default 0: the web's image chips), commands (the session's command names;",
    "default: commands below), expect {kind, text?, delivery?, local?}. kind is one of ComposerRoute::KINDS;",
    "text is compared only when given, trimmed; delivery is null unless given; local (the registry id) is",
    "Ruby's only (the web's own replies have none). web replaces expect for the page where it differs.",
    "note says why a row differs, or what a UI does past the route."
  ],
  "commands": ["/model", "/continue", "/help"],
  "rows": [
    { "text": "hello", "running": false, "expect": { "kind": "prompt", "text": "hello" } },
    { "text": "hello", "running": true, "expect": { "kind": "prompt", "text": "hello" } },
    { "text": "  padded line  ", "running": true, "expect": { "kind": "prompt", "text": "padded line" } },
    { "text": "first line\nsecond line", "running": true, "expect": { "kind": "prompt", "text": "first line\nsecond line" } },
    { "text": "", "running": false, "expect": { "kind": "empty" },
      "note": "the web never routes an empty line (app.js returns first); routeComposerLine would send \"\"" },

    { "text": "/cut stop that", "running": true, "expect": { "kind": "deliver", "text": "stop that", "delivery": "cut" } },
    { "text": "/cut\tdrop it", "running": true, "expect": { "kind": "deliver", "text": "drop it", "delivery": "cut" } },
    { "text": "/cut first\nsecond", "running": true, "expect": { "kind": "deliver", "text": "first\nsecond", "delivery": "cut" } },
    { "text": "/cut now this", "running": false, "expect": { "kind": "prompt", "text": "now this" } },
    { "text": "/queue later", "running": false, "expect": { "kind": "prompt", "text": "later" } },
    { "text": "/queue later", "running": true, "expect": { "kind": "deliver", "text": "later", "delivery": "queue" },
      "note": "the attached TUI refuses it for a worker without the delivery feature (it would steer); the web's chi web refuses it the same way (SessionManager.deliver_turn)" },
    { "text": "/queue\nthen this", "running": true, "expect": { "kind": "deliver", "text": "then this", "delivery": "queue" } },
    { "text": "/queue /model y", "running": true, "expect": { "kind": "deliver", "text": "/model y", "delivery": "queue" },
      "web": { "kind": "command", "text": "/model y" },
      "note": "as /cut /model y: the web routes a running /queue's text on (the command waits for the turn's end on its own); the terminals send it queued and the worker's Bridge runs it as the command" },
    { "text": "/cut", "running": true, "expect": { "kind": "usage" } },
    { "text": "/cut   ", "running": true, "expect": { "kind": "usage" } },
    { "text": "/queue  ", "running": false, "expect": { "kind": "usage" } },
    { "text": "/cut x", "running": true, "images": 1, "expect": { "kind": "deliver", "text": "x", "delivery": "cut" },
      "note": "the Bridge cuts only for a text-only message: with images it goes in at the next step" },
    { "text": "/cut", "running": true, "images": 2, "expect": { "kind": "usage" } },
    { "text": "/cutter x", "running": true, "expect": { "kind": "prompt", "text": "/cutter x" } },
    { "text": "/cutter", "running": false, "expect": { "kind": "typo" } },
    { "text": "/queued", "running": true, "expect": { "kind": "typo" } },

    { "text": "/cut /model y", "running": false, "expect": { "kind": "command", "text": "/model y" },
      "note": "attached TUI: sends /model y as a prompt; the worker's Bridge runs it as the command (same end)" },
    { "text": "/cut /stats", "running": false, "expect": { "kind": "local", "text": "/stats", "local": "stats" },
      "note": "divergence: the attached TUI sends /stats to the model as a turn (AttachedLoop#submit_delivery keeps an idle /cut's text as typed); the REPL shows its stats, the web its reply" },
    { "text": "/cut /modle", "running": false, "expect": { "kind": "typo", "text": "/modle" },
      "note": "divergence: the attached TUI sends /modle to the model as a turn (as /cut /stats); the REPL and the web show the typo hint" },
    { "text": "/cut /model y", "running": true, "expect": { "kind": "deliver", "text": "/model y", "delivery": "cut" },
      "web": { "kind": "command", "text": "/model y" },
      "note": "divergence: the web routes a running /cut's text on (a command runs, no cut); the REPL steers /model y as text with a cut; the attached TUI sends it with delivery cut and its Bridge runs it as the command" },

    { "text": "/model x", "running": false, "expect": { "kind": "command", "text": "/model x" } },
    { "text": "/model", "running": true, "expect": { "kind": "command", "text": "/model" } },
    { "text": "/continue no, enough", "running": true, "expect": { "kind": "command", "text": "/continue no, enough" } },
    { "text": "/model x", "running": false, "images": 1, "expect": { "kind": "prompt", "text": "/model x" } },
    { "text": "!ls -la", "running": false, "expect": { "kind": "command", "text": "!ls -la" } },
    { "text": "! git status", "running": true, "expect": { "kind": "command", "text": "! git status" } },
    { "text": "!", "running": false, "expect": { "kind": "prompt", "text": "!" } },
    { "text": "/modle", "running": false, "expect": { "kind": "typo", "text": "/modle" } },
    { "text": "/modle", "running": true, "expect": { "kind": "typo", "text": "/modle" } },
    { "text": "/foo bar", "running": false, "expect": { "kind": "prompt", "text": "/foo bar" } },
    { "text": "/foo\nbar", "running": false, "commands": ["/foo"], "expect": { "kind": "command", "text": "/foo\nbar" },
      "note": "a command line may break after the name (a plugin's annotation action: the command, then the quote)" },
    { "text": "/model\nx", "running": false, "expect": { "kind": "command", "text": "/model\nx" } },
    { "text": "/usr/bin/env", "running": false, "expect": { "kind": "prompt", "text": "/usr/bin/env" } },

    { "text": "/detach", "running": false, "expect": { "kind": "local", "local": "detach" } },
    { "text": "/exit", "running": true, "expect": { "kind": "local", "local": "exit" } },
    { "text": "/exit --delete", "running": false, "expect": { "kind": "local", "text": "/exit --delete", "local": "exit" } },
    { "text": "/quit", "running": false, "expect": { "kind": "local", "local": "exit" } },
    { "text": "/archive", "running": true, "expect": { "kind": "local", "local": "archive" } },
    { "text": "/stats", "running": false, "expect": { "kind": "local", "local": "stats" } },
    { "text": "/recap", "running": true, "expect": { "kind": "local", "local": "recap" } },
    { "text": "/exit now", "running": false, "expect": { "kind": "prompt", "text": "/exit now" },
      "web": { "kind": "local", "text": "/exit now" },
      "note": "by design: the web answers a terminal's word by its first word (webLocalReply); a terminal's /exit takes only --delete after it" },
    { "text": "exit", "running": false, "expect": { "kind": "local", "local": "exit" },
      "web": { "kind": "prompt", "text": "exit" },
      "note": "by design: the terminals read a bare exit as /exit; the web sends it" },
    { "text": "/CUT", "running": false, "expect": { "kind": "local", "text": "/CUT", "local": "cut" },
      "web": { "kind": "typo", "text": "/CUT" },
      "note": "divergence: the registry's /cut entry matches the bare word in any case, so both terminals run /CUT as a prompt (a local word neither UI answers); the web shows the typo hint" }
  ]
}
