#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "samagotchi/config_file"

Samagotchi::ConfigFile.load_global_env!
require "samagotchi"

# Early handle `sessions` subcommand before OptionParser (has its own flags like --dry-run)
if ARGV[0] == "sessions"
  require "samagotchi/session"
  require "samagotchi/session_manager"
  sessions_args = ARGV[1..] || []
  sub = sessions_args[0]
  if sub.nil? || %w[-h --help help].include?(sub)
    puts "Usage: bin/chi sessions <list|prune|clean> [options]"
    puts "  list [--sort updated_at|created_at] [--order desc|asc] [--limit N]"
    puts "  prune [--dry-run] [--days N] [--keep N] [--keep-status running,...] [--test-only]"
    puts "  clean [--dry-run] [--days N] [--keep N]   # alias to prune --test-only"
    puts "Defaults: days=14 keep=500 keep_status=running (env overrides: SAMAGOTCHI_SESSION_RETENTION_DAYS etc.)"
    exit 0
  end
  dry_run = sessions_args.include?("--dry-run")
  test_only = sessions_args.include?("--test-only") || sessions_args.include?("--test")
  days = nil
  keep = nil
  keep_status = nil
  sort = nil
  order = nil
  limit = nil
  sessions_args.each_with_index do |arg, i|
    nxt = sessions_args[i+1]
    if arg == "--days" && nxt then days = nxt.to_i
    elsif arg.start_with?("--days=") then days = arg.split("=",2).last.to_i
    elsif arg == "--keep" && nxt then keep = nxt.to_i
    elsif arg.start_with?("--keep=") then keep = arg.split("=",2).last.to_i
    elsif arg == "--keep-status" && nxt then keep_status = nxt
    elsif arg.start_with?("--keep-status=") then keep_status = arg.split("=",2).last
    elsif arg == "--sort" && nxt then sort = nxt
    elsif arg.start_with?("--sort=") then sort = arg.split("=",2).last
    elsif arg == "--order" && nxt then order = nxt
    elsif arg.start_with?("--order=") then order = arg.split("=",2).last
    elsif arg == "--limit" && nxt then limit = nxt.to_i
    elsif arg.start_with?("--limit=") then limit = arg.split("=",2).last.to_i
    end
  end
  case sub
  when "list"
    sort ||= "updated_at"
    order ||= "desc"
    sessions = Samagotchi::SessionManager.list_sessions(sort: sort, order: order, limit: limit)
    if sessions.empty?
      puts "No sessions."
    else
      sessions.each do |s|
        flag = s.test_run ? " [test]" : ""
        puts "#{s.id}  #{s.status.ljust(8)}  #{s.updated_at}  #{s.last_prompt.to_s.gsub(/\s+/, ' ')[0,60]}#{flag}"
      end
      puts "\n#{sessions.size} session(s) (sort=#{sort} order=#{order})"
    end
    exit 0
  when "prune", "clean"
    test_only = true if sub == "clean" && !sessions_args.include?("--all")
    result = Samagotchi::SessionManager.prune_sessions(days: days, max_count: keep, keep_status: keep_status, dry_run: dry_run, test_only: test_only)
    mode = dry_run ? "Would delete" : "Deleted"
    puts "#{mode} #{result[:deleted].size} sessions (kept #{result[:kept].size}, skipped #{result[:skipped].size})"
    if result[:deleted].any?
      result[:deleted].each { |id| puts "  #{id}" }
    end
    if dry_run && result[:deleted].any?
      puts "\nRun without --dry-run to delete."
    end
    exit 0
  else
    warn "Unknown sessions subcommand: #{sub}. Use: list, prune, clean"
    exit 1
  end
end

# Handle `memory` subcommand before OptionParser (has its own flags like --scope, --force)
if ARGV[0] == "memory"
  require "samagotchi/memory_bundle"
  memory_args = ARGV[1..] || []
  sub = memory_args[0]
  if sub.nil? || %w[-h --help help].include?(sub)
    puts "Usage: bin/chi memory <install|bundles> [options]"
    puts ""
    puts "  install <source> [--scope system|project] [--force]"
    puts "    Install a memory bundle from a directory, zip, or tar archive."
    puts "    Source is the path to the bundle (dir/zip/tar.gz)."
    puts "    --force overwrites existing entries; default skips them."
    puts ""
    puts "  bundles"
    puts "    List installed memory bundles and their provenance."
    exit 0
  end

  case sub
  when "install"
    # Parse install-specific flags from the remaining args
    rest = memory_args[1..]
    source = nil
    scope = nil
    force = false

    i = 0
    while i < rest.size
      arg = rest[i]
      if arg.start_with?("--")
        nxt = rest[i + 1]
        if %w[-h --help help].include?(arg)
          puts "Usage: bin/chi memory install <source> [--scope system|project] [--force]"
          puts ""
          puts "  install <source> [--scope system|project] [--force]"
          puts "    Install a memory bundle from a directory, zip, or tar archive."
          puts "    Source is the path to the bundle (dir/zip/tar.gz)."
          puts "    --force overwrites existing entries; default skips them."
          exit 0
        elsif arg == "--scope" && nxt
          scope = nxt
          i += 2
        elsif arg.start_with?("--scope=")
          scope = arg.split("=", 2).last
          i += 1
        elsif arg == "--force"
          force = true
          i += 1
        else
          warn "Unknown memory install flag: #{arg}"
          exit 1
        end
      else
        # Positional argument — the source path
        source = arg
        i += 1
      end
    end

    if source.nil? || source.empty?
      warn "Usage: bin/chi memory install <source> [--scope system|project] [--force]"
      exit 1
    end

    expanded_source = File.expand_path(source)

    # Derive bundle name from normalized dir (not source path) so zip/tar
    # produce clean names like "dmitry-base" instead of "dmitry-base.zip".
    require "yaml"
    normalized_dir = nil
    source_owned = false
    begin
      normalized_dir, source_owned = Samagotchi::MemoryBundle::SourceNormalizer.normalize(expanded_source)
      manifest = Samagotchi::MemoryBundle::Manifest.read(dir: normalized_dir)
    rescue Samagotchi::MemoryBundle::Manifest::ValidationError
      manifest = nil
    ensure
      Samagotchi::MemoryBundle::SourceNormalizer.cleanup(normalized_dir) if source_owned
    end

    if manifest
      bundle_name = manifest.name
    else
      bundle_name = File.basename(normalized_dir)
    end

    installer = Samagotchi::MemoryBundle::Installer.new(
      source: expanded_source,
      name: bundle_name,
      scope: scope,
      force: force,
      strict: true
    )

    begin
      normalized_dir, manifest = installer.run
      puts installer.summary
      puts "Provenance written to: #{Samagotchi::MemoryBundle::Provenance.bundles_dir}/#{bundle_name}/" if manifest
      # Warnings are informational; install still succeeds.
      if installer.warnings.any? || installer.placeholder_warnings.any?
        exit 0
      end
    rescue Samagotchi::MemoryBundle::Installer::InstallError => e
      warn "Install failed: #{e.message}"
      exit 1
    end

  when "bundles"
    require "json"
    bundles_dir = Samagotchi::MemoryBundle::Provenance.bundles_dir
    unless File.directory?(bundles_dir)
      puts "No installed bundles."
      exit 0
    end

    entries = Dir.entries(bundles_dir).reject { |e| e.start_with?(".") }
    if entries.empty?
      puts "No installed bundles."
    else
      puts "Installed memory bundles:"
      puts ""
      entries.sort.each do |name|
        prov = Samagotchi::MemoryBundle::Provenance.new(name: name)
        data = prov.read
        next unless data
        version = data[:version] || "?"
        scope = data[:scope] || "?"
        installed_at = data[:installed_at] || "?"
        file_count = (data[:files] || {}).size
        puts "  #{name}  v#{version}  scope=#{scope}  files=#{file_count}  installed=#{installed_at}"
      end
    end

  else
    warn "Unknown memory subcommand: #{sub}. Use: install, bundles"
    exit 1
  end

  exit 0
end

options = { verbose: false, no_interrupt: false, non_interactive: false, no_default_input: false, dashboard: false, web: false, web_port: nil, web_open: false }

OptionParser.new do |opts|
  opts.banner = "Usage: bin/chi [options] [subcommand]"
  opts.on("-p", "--prompt PROMPT", "Run a single prompt and exit") { |p| options[:prompt] = p }
  opts.on("--resume SESSION_ID", "Resume a previous session by its ID") { |s| options[:resume] = s }
  opts.on("--model NAME", "Model selector (runtime only, overrides --resume)") { |m| options[:model] = m }
  opts.on("--memory NAME", "Preload a memory entry into the system prompt (repeatable)") { |m| (options[:memories] ||= []) << m }
  opts.on("--backend NAME", %w[native ruby_llm], "Model backend to use (default: native)") { |b| options[:backend] = b }
  opts.on("--no-interrupt", "Raise the tool call limit to 1000 iterations (useful for long tasks)") { options[:no_interrupt] = true }
  opts.on("--non-interactive", "Run a single prompt and exit (no REPL, implies --no-interrupt)") { options[:non_interactive] = true }
  opts.on("-v", "--verbose", "Print raw LLM responses and tool calls/results") { options[:verbose] = true }
  opts.on("--no-default-input", "Skip default REPL input prefill") { options[:no_default_input] = true }
  opts.on("--port PORT", "Port for `chi web` (default: 4567, env SAMAGOTCHI_WEB_PORT)") { |p| options[:web_port] = p.to_i }
  opts.on("--open", "Open browser for `chi web`") { options[:web_open] = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit }
end.parse!

# Handle subcommands (support `chi web --port 4567 --open` and `chi dashboard`)
web_args = ARGV.dup
case ARGV[0]
when "dashboard"
  options[:dashboard] = true
when "web"
  options[:web] = true
  # consume subcommand and re-parse web-specific flags that may follow it
  web_args.shift
  web_args.each_with_index do |arg, i|
    if arg == "--port" && web_args[i + 1]
      options[:web_port] = web_args[i + 1].to_i
    elsif arg == "--open"
      options[:web_open] = true
    elsif arg.start_with?("--port=")
      options[:web_port] = arg.split("=", 2).last.to_i
    end
  end
end

if options[:web]
  require "samagotchi/web/server"
  port = options[:web_port]
  port = ENV.fetch("SAMAGOTCHI_WEB_PORT", port || 4567).to_i
  Samagotchi::Web::Server.start(port: port, open_browser: options[:web_open])
  exit
end

if options[:dashboard]
  warn "[deprecated] `chi dashboard` is deprecated — use `chi web` instead"
  require "samagotchi/dashboard"
  Samagotchi::Dashboard.new.run
  exit
end

# Export the selected backend so the Engine resolves it (Engine#initialize reads
# SAMAGOTCHI_BACKEND). A --backend flag wins over a config.yml / pre-set value
# because it sets the env key directly; with no flag, resolve_provider falls
# back to the (already-loaded) env / :native default.
ENV["SAMAGOTCHI_BACKEND"] = options[:backend] if options[:backend]

log_file = if ["1", "true"].include?(ENV.fetch("SAMAGOTCHI_DISABLE_LOG_FILE", "").downcase)
             nil
           else
             ENV.fetch("SAMAGOTCHI_LOG_FILE", File.expand_path("../tmp/samagotchi.log", __dir__))
           end

Samagotchi::TerminalUI.new(
  prompt: options[:prompt],
  verbose: options[:verbose],
  log_file: log_file,
  session_id: options[:resume],
  no_interrupt: options[:no_interrupt] || options[:non_interactive],
  no_default_input: options[:no_default_input],
  memories: options[:memories] || [],
  non_interactive: options[:non_interactive],
  model_name: options[:model]
).run

