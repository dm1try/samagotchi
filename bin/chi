#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

# LC_ALL=C or no locale at all: files would read as US-ASCII, and chi's
# memories and sessions are UTF-8 (Utf8Default).
require "samagotchi/utf8_default"
Samagotchi::Utf8Default.apply!

require "samagotchi/config"

begin
  Samagotchi::ConfigFile.load!
rescue Samagotchi::ConfigFile::RemovedApi => e
  warn "Error: #{e.message}"
  exit 1
end
require "samagotchi"

# `chi self`: print version, source dir, config/memory/session paths, model and
# bundles (read-only, offline) — lets the agent find its own code and state.
if ARGV[0] == "self"
  if %w[-h --help help].include?(ARGV[1])
    puts "Usage: chi self [--model]"
    puts "  Print version, source dir, config/memory/session paths, model/host and bundles."
    puts "  --model  print only the model a new session starts on, an alias resolved (exit 1 when none is configured)"
    exit 0
  end
  require "samagotchi/self_report"
  # The desktop helper's hint for its "New session" row: offline and quick.
  if ARGV[1] == "--model"
    model = Samagotchi::SelfReport.model_ref_name
    puts model if model
    exit(model ? 0 : 1)
  end
  puts Samagotchi::SelfReport.text
  exit 0
end

# Subcommands with their own flags, dispatched before OptionParser.
SUBCOMMANDS = {
  # list, stop, archive/unarchive, delete, prune, clean, stats (--dry-run, --days, …)
  "sessions" => ["samagotchi/sessions_command", "SessionsCommand"],
  # a context note for sessions (-m, --source, --all)
  "note" => ["samagotchi/note_command", "NoteCommand"],
  # a note for every session it may concern (-m, --all, --dry-run)
  "broadcast" => ["samagotchi/broadcast_command", "BroadcastCommand"],
  # live external text attached to sessions (add, push, ls, show, rm, mute)
  "context" => ["samagotchi/context_command", "ContextCommand"],
  # a message into sessions as the user's (-m)
  "send" => ["samagotchi/send_command", "SendCommand"],
  # answer the question a session waits on, then wait (--question, --option)
  "answer" => ["samagotchi/answer_command", "AnswerCommand"],
  # invite participants to review a session, list them, revoke them
  "share" => ["samagotchi/share_command", "ShareCommand"],
  # a review session for files, or of a session (--from, --dir, --model)
  "review" => ["samagotchi/review_command", "ReviewCommand"],
  # find a model server and write config.yml (--model, --name)
  "bootstrap" => ["samagotchi/bootstrap_command", "BootstrapCommand"],
  # bring an installed chi up to date
  "update" => ["samagotchi/update_command", "UpdateCommand"],
  # the models --model takes, from every host (--format, --timeout)
  "models" => ["samagotchi/models_command", "ModelsCommand"],
  # the native "Send to chi" helper
  "desktop" => ["samagotchi/desktop_command", "DesktopCommand"],
  # list and remove memories (ls, rm; --scope, --format)
  "memory" => ["samagotchi/memory_command", "MemoryCommand"],
  # install, upgrade, uninstall, status, diff, list, build (--scope, --force, …)
  "bundle" => ["samagotchi/bundle_command", "BundleCommand"],
  # other machines' chi web, for chi --remote NAME (add, ls, rm)
  "remote" => ["samagotchi/remote_command", "RemoteCommand"]
}.freeze
# chi --remote NAME <command> (or CHI_REMOTE=NAME): the session commands
# against another machine's chi web; what runs here only is refused (exit 2).
# chi remote, --version and --help run here as always. Run flags under a
# remote (--attach, --resume, -p, --dir: a session there in this terminal)
# are parsed below and go to RemoteAttachCommand before this machine's
# checks; the local-only ones are refused here.
require "samagotchi/session_access/dispatch"
begin
  remote_run = Samagotchi::SessionAccess::Dispatch.from(ARGV)
rescue Samagotchi::SessionAccess::Dispatch::Usage => e
  warn "Error: #{e.message}"
  exit 2
end
ARGV.replace(remote_run.argv)
remote_attach = remote_run.remote? && !remote_run.here? && remote_run.run_flags?
if remote_attach && (refusal = remote_run.refusal)
  warn "Error: #{refusal}"
  exit 2
end
exit remote_run.run(SUBCOMMANDS) if remote_run.remote? && !remote_run.here? && !remote_attach

if (path, klass = SUBCOMMANDS[ARGV[0]])
  require path
  exit Samagotchi.const_get(klass).new(ARGV[1..] || []).run
end

# `chi scratch`: the run options below, for a session that leaves nothing
# behind (TerminalUI scratch:). The word goes before OptionParser sees it.
scratch = ARGV[0] == "scratch"
ARGV.shift if scratch

# The run flags (RunOptions: the parser and its checks); what is left in
# ARGV is `web` or a stray word.
require "samagotchi/run_options"
options, cli_overrides = Samagotchi::RunOptions.parse(ARGV)

# The subcommands with their own parsers ran above; what parse! leaves is
# `web` or nothing. Anything else is a typo, not a prompt: refuse it rather
# than start a session.
web = ARGV.first == "web" && !scratch
stray = web ? ARGV[1] : ARGV.first
if stray
  warn "Error: #{web || scratch ? "unexpected argument" : "unknown command"} #{stray} (see chi --help)"
  exit 1
end
if options[:new_token] && !web
  warn "Error: --new-token goes with chi web (chi web --new-token)"
  exit 1
end
if options[:sets] && web
  warn "Error: --set is a new session's (chi --set, chi send --new --set), not chi web's"
  exit 2
end
# --parent-answers: a level in any case (no abbreviations), else a usage
# error, as chi send's.
if options[:parent_answers]
  require "samagotchi/guardrails/parent_levels"
  levels = Samagotchi::Guardrails::ParentPolicy::ORDER
  level = Samagotchi::Guardrails::ParentPolicy.parse_level(options[:parent_answers])
  unless levels.include?(level)
    warn "Error: --parent-answers takes #{levels.join(", ")}, not #{options[:parent_answers]}"
    exit 2
  end
  options[:parent_answers] = level
end
if options[:parent_answers] && web
  warn "Error: --parent-answers is a new session's (chi --parent-answers, chi send --new --parent-answers), not chi web's"
  exit 2
end

# A scratch session is new, runs here and goes when it ends.
if scratch
  flag = { resume: "--resume", attach: "--attach", shared: "--shared" }.find { |key, _flag| options[key] }&.last
  if flag
    warn "Error: chi scratch starts a new session in this terminal and keeps nothing; it can't take #{flag}"
    exit 1
  end
end

# --thinking: chi web's is a default for the workers it spawns (below a
# session's own level); a session-starting run's is that session's own
# (TerminalUI, AttachLauncher), not a process setting.
cli_overrides["thinking.level"] = options[:thinking] if web && options[:thinking]

# Apply CLI precedence: CLI > ENV > file. Workers this chi spawns get
# these through their env (Config.cli_env).
Samagotchi::Config.reload!(cli_overrides: cli_overrides) unless cli_overrides.empty?

# The debug log (Samagotchi::LogPath, level log.level) for every command.
# -v (the plain REPL only): debug records, each mirrored to stderr.
require "samagotchi/log"
Samagotchi::Log.configure(level: options[:verbose] ? :debug : nil, mirror: options[:verbose])

# chi --remote NAME --attach ID (--resume ID, --dir DIR, -p TEXT): the
# attached TUI on that machine's session. Nothing below runs: it checks
# this machine's sessions, memories and files.
if remote_attach
  unless ARGV.empty?
    warn "Error: unknown command #{ARGV.first} (see chi --help)"
    exit 1
  end
  require "samagotchi/remote_attach_command"
  begin
    entry = Samagotchi::Remotes.find(Samagotchi::Remotes.check_name!(remote_run.remote))
  rescue Samagotchi::Remotes::Invalid => e
    warn "Error: #{e.message}"
    exit 2
  end
  exit Samagotchi::RemoteAttachCommand.new(options, access: Samagotchi::SessionAccess::Remote.new(entry)).run
end
# --dir names a folder on a remote; here the session starts in this one.
if options[:dir]
  warn "Error: --dir goes with --remote; cd there instead"
  exit 2
end

# `chi web`: its flags (--port, --open, --web-view…) went through the parser above.
options[:web] = true if web

# The first interactive start of a new installed chi says what `chi update` would update.
chi_update_hint = lambda do
  require "samagotchi/installed_gem"
  require "samagotchi/update_hint"
  if Samagotchi::UpdateHint.wanted?(prompt: options[:prompt], non_interactive: options[:non_interactive],
                                    tty: $stdin.tty? && $stdout.tty?, installed: Samagotchi::InstalledGem.spec)
    Samagotchi::UpdateHint.show
  end
end

if options[:web]
  chi_update_hint.call
  require "samagotchi/web/server"
  port = options[:web_port] || Samagotchi::Config.get("web.port")
  markdown = options[:web_markdown]
  markdown = Samagotchi::Config.get("web.markdown") if markdown.nil?
  view = Samagotchi::Config.get("web.view")
  exit Samagotchi::Web::Server.launch(port: port, scope: options[:scope] || "project", open_browser: options[:web_open],
                                      markdown: markdown, view: view, new_token: options[:new_token],
                                      working_set: Samagotchi::Config.get("web.working_set"),
                                      annotate_presets: Samagotchi::Config.get("web.annotate_presets"),
                                      editor: Samagotchi::Config.get("web.editor"))
end

# --resume and --attach take a unique id prefix too, like git.
begin
  %i[resume attach].each { |key| options[key] &&= Samagotchi::Session.resolve_id(options[key]) }
rescue Samagotchi::Session::AmbiguousId => e
  warn "Error: #{e.message}"
  exit 1
end

# A `chi scratch` session a killed REPL left behind would turn into a kept
# one if opened again; the next sweep deletes it.
%i[resume attach].each do |key|
  next unless options[key]

  leftover = begin
    Samagotchi::Session.load(options[key]).scratch
  rescue ArgumentError
    false # no such session: the launch says so
  end
  next unless leftover

  require "samagotchi/launch_mode"
  warn "Error: #{Samagotchi::LaunchMode::SCRATCH_LEFTOVER}"
  exit 1
end

# --memory and --mute names are checked here, before the launch: a worker's
# stderr goes nowhere, so its engine's warnings would not be seen. Warnings
# only; the session starts either way.
if options[:memories] || options[:muted]
  require "samagotchi/muted_memories"
  require "samagotchi/memory_bundle/system_bundle"
  begin
    Samagotchi::MemoryBundle::SystemBundle.ensure!
  rescue StandardError
    nil
  end
  memory_exists = lambda do |raw|
    scope, name = raw.split("/", 2)
    unless name && Samagotchi::Tools::VALID_SCOPES.include?(scope)
      scope = nil
      name = raw
    end
    !Samagotchi::Tools::MemoryRead.call(name, scope: scope).start_with?("Error:")
  end
  cli_memories = (options[:memories] || []).flat_map { |m| m.split(",") }.map(&:strip).reject(&:empty?)
  cli_memories.each { |m| warn "Warning: --memory '#{m}' not found" unless memory_exists.call(m) }
  muted = Samagotchi::MutedMemories.normalize_list(options[:muted] || [])
  baseline = Samagotchi::ConfigFile.preloaded_memories
  muted.each do |name|
    if cli_memories.any? { |m| Samagotchi::MutedMemories.normalize(m) == name }
      warn "Warning: '#{name}' is both --memory and --mute; muted"
    elsif baseline.any? { |m| Samagotchi::MutedMemories.normalize(m) == name }
      warn "Warning: '#{name}' is in config.yml memories: and --mute; muted for this session"
    elsif !memory_exists.call(name)
      warn "Warning: --mute '#{name}' matches no memory"
    end
  end
end

# --llm-context*: checked here, before anything starts.
if options[:llm_context]
  require "samagotchi/llm_context_override"
  begin
    Samagotchi::LLMContextOverride.update(nil, options[:llm_context])
  rescue ArgumentError => e
    warn "Error: #{e.message}"
    exit 1
  end
end

# --append-system-prompt: each file is checked here, before anything starts
# (the user named it, so a missing one is an error), and made absolute
# against this shell's cwd.
if options[:append_system_prompt]
  require "samagotchi/prompt_files"
  options[:appended_prompt_files] = options[:append_system_prompt].map do |value|
    path, reason = Samagotchi::PromptFiles.check_cli_file(value)
    if reason
      warn "Error: --append-system-prompt #{value}: #{reason}"
      exit 1
    end
    chars = Samagotchi::PromptFiles.large_size(path)
    warn "Warning: --append-system-prompt #{value} is #{chars} chars; it is in every request" if chars
    path
  end.uniq
end

# --toolkit/--tool/--no-tool: a new session's toolkit, as named (the
# worker resolves it; a bundle's toolkit isn't known here).
if options[:toolkit] || options[:tools] || options[:no_tools]
  require "samagotchi/toolkit"
  # The flags as given, for the line an existing session's run prints.
  options[:toolkit_flags] = [("--toolkit" if options[:toolkit]), ("--tool" if options[:tools]),
                             ("--no-tool" if options[:no_tools])].compact
  options[:toolkit_value] = Samagotchi::Toolkit.from_flags(name: options[:toolkit], add: options[:tools],
                                                           remove: options[:no_tools])
end

# --set KEY=VALUE / BUNDLE.KEY=VALUE: a new session's own settings, checked
# here (a core key against its Config entry, a bundle's against the installed
# bundles), so a typo isn't saved.
if options[:sets]
  require "samagotchi/session_config"
  begin
    options[:settings] = Samagotchi::SessionConfig.from_flags(options[:sets])
  rescue Samagotchi::SessionConfig::Error => e
    warn "Error: #{e.message}"
    exit 2
  end
  # An existing session's run names it among the flags it ignores.
  options[:toolkit_flags] = (options[:toolkit_flags] || []) + ["--set"]
end

# --parent-answers LEVEL: a new session's own guardrails.parent_answers. An
# existing session's (--attach/--resume) is ignored with the flags' line,
# never sent as a /parent-answers command: that would loosen it from a
# command line, which is the user's to do in a UI.
if options[:parent_answers]
  if options[:attach] || options[:resume]
    options[:toolkit_flags] = (options[:toolkit_flags] || []) + ["--parent-answers"]
  else
    require "samagotchi/guardrails/parent_policy"
    note = Samagotchi::Guardrails::ParentPolicy.capped_note(options[:parent_answers])
    warn "Warning: --parent-answers #{note}" if note
  end
end

chi_update_hint.call
require "samagotchi/launch_mode"
launch, launch_note = if scratch
                        [:repl, nil]
                      else
                        Samagotchi::LaunchMode.resolve(options, shared_config: Samagotchi::Config.get("session.shared"))
                      end
warn launch_note if launch_note

if launch == :attached
  error = Samagotchi::LaunchMode.attached_conflict(options)
  if error
    warn "Error: #{error}"
    exit 1
  end

  require "samagotchi/terminal_ui/attach_launcher"
  begin
    ended = Samagotchi::TerminalUI::AttachLauncher.run(attach: options[:attach], shared: !options[:attach], resume: options[:resume],
                                                       prompt: options[:prompt], model: options[:model],
                                                       no_interrupt: !!options[:no_interrupt],
                                                       default_input: !options[:no_default_input],
                                                       memories: options[:memories] || [],
                                                       muted_memories: options[:muted] || [],
                                                       llm_context: options[:llm_context] || {},
                                                       thinking: options[:thinking],
                                                       appended_prompt_files: options[:appended_prompt_files] || [],
                                                       toolkit: options[:toolkit_value],
                                                       toolkit_flags: options[:toolkit_flags] || [],
                                                       settings: options[:settings],
                                                       parent_answers: options[:parent_answers])
  rescue Samagotchi::TerminalUI::AttachLauncher::Error => e
    warn "Error: #{e.message}"
    exit 1
  rescue Interrupt
    # Ctrl-C while it connects (a wait for a leaving worker, a late Bridge):
    # no backtrace.
    exit Samagotchi::CLI::Exit::INTERRUPTED
  end
  exit Samagotchi::TerminalUI::AttachLauncher.exit_status(ended)
end

require "samagotchi/cli/exit"
begin
  ended = Samagotchi::TerminalUI.new(
    prompt: options[:prompt],
    session_id: options[:resume],
    no_interrupt: options[:no_interrupt] || options[:non_interactive],
    no_default_input: options[:no_default_input],
    memories: options[:memories] || [],
    muted_memories: options[:muted] || [],
    llm_context: options[:llm_context] || {},
    thinking: options[:thinking],
    appended_prompt_files: options[:appended_prompt_files] || [],
    toolkit: options[:toolkit_value],
    toolkit_flags: options[:toolkit_flags] || [],
    settings: options[:settings],
    parent_answers: options[:parent_answers],
    non_interactive: options[:non_interactive],
    model_name: options[:model],
    scratch: scratch
  ).run
  # `chi -p X </dev/null`: the turn failed (nothing was sent again); -p
  # --non-interactive: the turn ended with no answer or at the iteration
  # limit, or Ctrl-C cancelled it.
  exit 1 if %i[turn_failed empty_answer iteration_limit].include?(ended)
  exit Samagotchi::CLI::Exit::INTERRUPTED if ended == :interrupted
rescue Samagotchi::TerminalUI::SessionBusy, Samagotchi::TerminalUI::SessionNotFound, Samagotchi::ModelProfile::MissingModel => e
  warn "Error: #{e.message}"
  exit 1
rescue Samagotchi::LLM::ProviderError => e
  # -p --non-interactive: the turn failed; its prompt is in the session.
  warn "Error: #{e.summary}"
  exit 1
rescue Samagotchi::ImageStore::Error => e
  # -p --non-interactive: an @path image that can't be used.
  warn "Error: #{e.message}"
  exit 1
end
