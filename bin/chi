#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "samagotchi/config_file"

Samagotchi::ConfigFile.load_global_env!
require "samagotchi"

options = { verbose: false, no_interrupt: false, non_interactive: false, no_default_input: false, dashboard: false, web: false, web_port: nil, web_open: false }

OptionParser.new do |opts|
  opts.banner = "Usage: bin/chi [options] [subcommand]"
  opts.on("-p", "--prompt PROMPT", "Run a single prompt and exit") { |p| options[:prompt] = p }
  opts.on("--resume SESSION_ID", "Resume a previous session by its ID") { |s| options[:resume] = s }
  opts.on("--memory NAME", "Preload a memory entry into the system prompt (repeatable)") { |m| (options[:memories] ||= []) << m }
  opts.on("--backend NAME", %w[native ruby_llm], "Model backend to use (default: native)") { |b| options[:backend] = b }
  opts.on("--no-interrupt", "Raise the tool call limit to 1000 iterations (useful for long tasks)") { options[:no_interrupt] = true }
  opts.on("--non-interactive", "Run a single prompt and exit (no REPL, implies --no-interrupt)") { options[:non_interactive] = true }
  opts.on("-v", "--verbose", "Print raw LLM responses and tool calls/results") { options[:verbose] = true }
  opts.on("--no-default-input", "Skip default REPL input prefill") { options[:no_default_input] = true }
  opts.on("--port PORT", "Port for `chi web` (default: 4567, env SAMAGOTCHI_WEB_PORT)") { |p| options[:web_port] = p.to_i }
  opts.on("--open", "Open browser for `chi web`") { options[:web_open] = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit }
end.parse!

# Handle subcommands (support `chi web --port 4567 --open` and `chi dashboard`)
web_args = ARGV.dup
case ARGV[0]
when "dashboard"
  options[:dashboard] = true
when "web"
  options[:web] = true
  # consume subcommand and re-parse web-specific flags that may follow it
  web_args.shift
  web_args.each_with_index do |arg, i|
    if arg == "--port" && web_args[i + 1]
      options[:web_port] = web_args[i + 1].to_i
    elsif arg == "--open"
      options[:web_open] = true
    elsif arg.start_with?("--port=")
      options[:web_port] = arg.split("=", 2).last.to_i
    end
  end
end

if options[:web]
  require "samagotchi/web/server"
  port = options[:web_port]
  port = ENV.fetch("SAMAGOTCHI_WEB_PORT", port || 4567).to_i
  Samagotchi::Web::Server.start(port: port, open_browser: options[:web_open])
  exit
end

if options[:dashboard]
  warn "[deprecated] `chi dashboard` is deprecated — use `chi web` instead"
  require "samagotchi/dashboard"
  Samagotchi::Dashboard.new.run
  exit
end

# Export the selected backend so the Engine resolves it (Engine#initialize reads
# SAMAGOTCHI_BACKEND). A --backend flag wins over a config.yml / pre-set value
# because it sets the env key directly; with no flag, resolve_provider falls
# back to the (already-loaded) env / :native default.
ENV["SAMAGOTCHI_BACKEND"] = options[:backend] if options[:backend]

log_file = if ["1", "true"].include?(ENV.fetch("SAMAGOTCHI_DISABLE_LOG_FILE", "").downcase)
             nil
           else
             ENV.fetch("SAMAGOTCHI_LOG_FILE", File.expand_path("../tmp/samagotchi.log", __dir__))
           end

Samagotchi::TerminalUI.new(
  prompt: options[:prompt],
  verbose: options[:verbose],
  log_file: log_file,
  session_id: options[:resume],
  no_interrupt: options[:no_interrupt] || options[:non_interactive],
  no_default_input: options[:no_default_input],
  memories: options[:memories] || [],
  non_interactive: options[:non_interactive]
).run

