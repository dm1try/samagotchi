#!/usr/bin/env node
// The Home Screen app's icons (Web Push), rendered from favicon.svg's
// drawing with Playwright's Chromium (a dev dependency; once: npx playwright
// install chromium) and checked in: lib/samagotchi/web/public/icons/chi-180,
// -192, -512.png and apple-touch-icon.png (= 180). Full bleed and opaque: iOS
// fills transparency with black and rounds the corners itself. Run it again
// after favicon.svg changes:
//
//   node script/render-icons
import { readFileSync, writeFileSync, copyFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { chromium } from "@playwright/test";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const pub = join(root, "lib/samagotchi/web/public");
// favicon.svg with its rounded square made a full square: the gradient
// fills the icon edge to edge, the glyph stays where it is.
const svg = readFileSync(join(pub, "favicon.svg"), "utf8")
  .replace(/<rect [^>]*\/>/, '<rect x="0" y="0" width="32" height="32" fill="url(#g)"/>');

const browser = await chromium.launch();
try {
  const page = await browser.newPage();
  for (const size of [180, 192, 512]) {
    await page.setViewportSize({ width: size, height: size });
    await page.setContent(`<html><body style="margin:0;background:#7aa5ff">${svg
      .replace("<svg ", `<svg width="${size}" height="${size}" `)}</body></html>`);
    writeFileSync(join(pub, `icons/chi-${size}.png`), await page.screenshot({ omitBackground: false }));
  }
} finally {
  await browser.close();
}
copyFileSync(join(pub, "icons/chi-180.png"), join(pub, "apple-touch-icon.png"));
console.log("icons written to lib/samagotchi/web/public/icons/ and apple-touch-icon.png");
