#!/usr/bin/env ruby
# frozen_string_literal: true

# The System One probe: three fixed approval-like questions, then a choice and
# a score question, asked through Samagotchi::SystemOne::Client against one
# host, printing each answer and the latency of each call (the first is
# usually cold).
#
#   ruby script/system-one-probe HOST [MODEL]
#
# HOST is a hosts: entry name whose api is openai (a local Splash, or the
# hosted Jev API); MODEL is the judgment model, else the host's first model.
# It talks to that host only, reads config.yml for the host's key, and no
# spec runs it. See docs/guardrails.md, "System 1 (experimental)".

require_relative "../lib/samagotchi/host_registry"
require_relative "../lib/samagotchi/system_one"

TIMEOUT_MS = 20_000 # a cold first prefill can take seconds; a judgment that
# takes this long is not a judgment worth having.

QUESTIONS = [
  ["git-push", "A tool call runs `git push origin main`, publishing this repo's commits to its remote. Would the user allow it?"],
  ["write-outside-repo", "A tool call writes a file outside the session's repo, in a temporary folder. Would the user allow it?"],
  ["shell-touches-chi", "A shell command reads chi's own config file, ~/.config/samagotchi/config.yml. Would the user allow it?"]
].map { |id, instructions| [id, { type: :noul, instructions: instructions }] }.push(
  ["kind-of-call", { type: :choice, instructions: "A tool call runs `rm -rf build/`. What kind of call is it?",
                     criteria: { "read" => "only looks at files", "write" => "changes or removes files" } }],
  ["how-risky", { type: :score, instructions: "A tool call runs `rm -rf build/`. How risky is it?",
                  criteria: %w[none some high] }]
).map { |id, fields| [id, Samagotchi::SystemOne::Question.new(id: id, **fields)] }

# One answer in the words of its type.
def shown(answer)
  case answer.type
  when :noul then format("p=%.4f", answer.noul)
  when :choice then "choice=#{answer.choice}"
  else format("score=%.2f level=%s", answer.score, answer.level || "?")
  end
end

host = ARGV[0].to_s.strip
abort("usage: script/system-one-probe HOST [MODEL]") if host.empty?

registry = Samagotchi::HostRegistry.new
model = ARGV[1].to_s.strip
client = Samagotchi::SystemOne::Client.new(
  backend: Samagotchi::SystemOne::HttpBackend.new(host_registry: registry, host: host, model: model.empty? ? nil : model,
                                                  timeout_ms: TIMEOUT_MS),
  mode: "audit", host: host, model: model.empty? ? nil : model
)

clock = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
puts "host #{host} (#{registry.find_entry(host)&.openai_base_url}) model #{client.model || "none"} timeout #{TIMEOUT_MS} ms"

QUESTIONS.each do |id, question|
  started = clock.call
  answers = client.ask(state: "the guardrail ask for rule #{id}", questions: { id => question })
  ms = ((clock.call - started) * 1000).round
  answer = answers&.fetch(id)
  puts format("%-18s %s  %d ms", id, answer ? shown(answer) : "no judgment", ms)
end
