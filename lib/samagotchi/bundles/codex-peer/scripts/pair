#!/bin/sh
# pair: pair this Codex CLI session with a chi session (chi's codex-peer
# bundle). Run from Codex, which sets CODEX_THREAD_ID:
#
#   sh <bundle dir>/scripts/pair <chi session id, prefix or chi web URL>
#
# It pairs (`chi peer pair codex <id> --address <thread>`): the address is
# this session's thread id (chi's codex_send tool runs
# `codex queue --thread <id>` with it); Codex's answers go to the session's
# mailbox (`chi peer say codex <id>`). Again later, it only refreshes the
# thread id. CHI names the chi command (default: chi on the PATH). Through a
# remote (CHI_REMOTE, or --remote NAME in CHI) chi there can't queue to this
# machine's Codex: it pairs for answers only (no address), and says so.
#
# chi peer writes the session's mailbox under chi's state folder, which
# Codex's default sandbox doesn't let it write: ~/.codex/config.toml needs
#   [sandbox_workspace_write]
#   writable_roots = ["<state>/samagotchi/mailbox"]
# and a write refused says so. Through a remote chi talks HTTP instead,
# which the sandbox may refuse (no network): a connection that fails says so.
set -eu

usage() {
  echo "usage: pair <chi session id or URL (http://127.0.0.1:4567/#/s/<id>)>" >&2
  exit 2
}

[ $# -eq 1 ] || usage
case "$1" in
  -h | --help) usage ;;
  http://* | https://*)
    id=$(printf '%s\n' "$1" | sed -n 's|.*/s/\([0-9A-Za-z-][0-9A-Za-z-]*\).*|\1|p')
    [ -n "$id" ] || { echo "pair: no session id in $1 (a chi web URL ends in #/s/<id>)" >&2; exit 2; }
    ;;
  *) id=$1 ;;
esac

thread=${CODEX_THREAD_ID:-}
if [ -z "$thread" ]; then
  echo "pair: CODEX_THREAD_ID isn't set: run this from a Codex CLI session" >&2
  exit 2
fi
chi=${CHI:-chi}

# The remote, as SessionAccess::Dispatch names it: a --remote NAME (or
# --remote=NAME) word in CHI, the last one, beats CHI_REMOTE (trimmed; blank:
# local). An empty or dash-led name is still a remote: chi refuses it.
remote=$(printf '%s\n' "${CHI_REMOTE:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
via= take=
[ -z "$remote" ] || via=env
for word in $chi; do
  if [ -n "$take" ]; then
    remote=$word take=
    continue
  fi
  case "$word" in
    --remote) remote= via=chi take=1 ;;
    --remote=*) remote=${word#--remote=} via=chi ;;
  esac
done

config='~/.codex/config.toml'
[ -z "${CODEX_HOME:-}" ] || config=$CODEX_HOME/config.toml

# Prints chi's error, and the config line when the sandbox may have refused:
# writable_roots here, network_access through a remote.
fail() {
  printf '%s\n' "$1" >&2
  if [ -n "$via" ]; then
    case "$1" in
      *"connection broke"* | *"can't find host"* | *"host unreachable"* | *"no answer within"*)
        cat >&2 <<MSG
pair: Codex's sandbox may be keeping chi from reaching $remote (workspace-write has no network by default): if so, add to $config
  [sandbox_workspace_write]
  network_access = true
then restart Codex and pair again.
MSG
        ;;
    esac
    exit 1
  fi
  case "$1" in
    *"Operation not permitted"* | *"Read-only file system"* | *"Permission denied"*)
      state=${XDG_STATE_HOME:-$HOME/.local/state}
      cat >&2 <<MSG
pair: Codex's sandbox can't write chi's state: add to $config
  [sandbox_workspace_write]
  writable_roots = ["$state/samagotchi/mailbox"]
then restart Codex and pair again.
MSG
      ;;
  esac
  exit 1
}

# Pairs, saying what chi said when it failed.
pair() {
  if ! out=$($chi peer pair codex "$id" "$@" 2>&1); then
    fail "$out"
  fi
}

if [ -n "$via" ]; then
  pair --from "Codex in $PWD (on another machine)"
  ask=$chi
  [ "$via" = chi ] || ask="CHI_REMOTE=$remote $chi"
  printf '%s\n' "pair: chi is on $remote, so chi can't send to this Codex session (codex_send runs codex queue on chi's machine): paired with chi $id for answers only. Answer chi with $ask peer say codex $id; chi's replies reach you only when the user relays them (or asks you to run $ask send --wait $id)"
  exit 0
fi

pair --address "$thread" --from "Codex in $PWD"
echo "paired with chi $id (thread $thread)"
