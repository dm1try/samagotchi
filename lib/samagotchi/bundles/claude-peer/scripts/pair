#!/bin/sh
# pair: pair this Claude Code session with a chi session (chi's claude-peer
# bundle). Run from Claude Code, which sets CLAUDE_CODE_MESSAGING_SOCKET:
#
#   sh <bundle dir>/scripts/pair <chi session id, prefix or chi web URL>
#
# It pairs (`chi peer pair claude <id> --address <socket>`): the address is
# this session's inbox socket, where chi's claude_send tool writes; Claude's
# answers go to the session's mailbox (`chi peer say claude <id>`). Again
# after a Claude restart, it only refreshes the socket. CHI names the chi
# command (default: chi on the PATH). Through a remote (CHI_REMOTE, or
# --remote NAME in CHI) chi there can't reach this machine's socket: it pairs
# for answers only (no address), and says so. With --inbox-socket PATH the
# address is PATH instead, a socket on chi's machine made by forwarding this
# Claude's socket there with `ssh -R`, so chi can send here too
# (docs/peers.md).
set -eu

usage() {
  echo "usage: pair [--inbox-socket PATH] <chi session id or URL (http://127.0.0.1:4567/#/s/<id>)>" >&2
  exit 2
}

# The id (or URL) and, optionally, the socket on chi's machine to send through.
inbox= target=
while [ $# -gt 0 ]; do
  case "$1" in
    --inbox-socket)
      [ $# -ge 2 ] || usage
      inbox=$2
      shift 2
      [ -n "$inbox" ] || usage
      ;;
    --inbox-socket=*)
      inbox=${1#--inbox-socket=}
      shift
      [ -n "$inbox" ] || usage
      ;;
    -h | --help) usage ;;
    *)
      [ -z "$target" ] || usage
      target=$1
      shift
      ;;
  esac
done
[ -n "$target" ] || usage

# A relative path would be chi's cwd, not the forward's remote end: the
# plugin's check refuses it, so refuse it here with the reason.
case "$inbox" in
  "") ;;
  /*) ;;
  *) echo "pair: --inbox-socket needs an absolute socket path on chi's machine (the ssh -R forward's remote end): $inbox" >&2
     exit 2 ;;
esac

sock=${CLAUDE_CODE_MESSAGING_SOCKET:-}
if [ -z "$sock" ]; then
  echo "pair: CLAUDE_CODE_MESSAGING_SOCKET isn't set: run this from a Claude Code session (2.1.224 or later)" >&2
  exit 2
fi

chi=${CHI:-chi}

# The remote, as SessionAccess::Dispatch names it: a --remote NAME (or
# --remote=NAME) word in CHI, the last one, beats CHI_REMOTE (trimmed; blank:
# local). An empty or dash-led name is still a remote: chi refuses it.
remote=$(printf '%s\n' "${CHI_REMOTE:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
via= take=
[ -z "$remote" ] || via=env
for word in $chi; do
  if [ -n "$take" ]; then
    remote=$word take=
    continue
  fi
  case "$word" in
    --remote) remote= via=chi take=1 ;;
    --remote=*) remote=${word#--remote=} via=chi ;;
  esac
done

case "$target" in
  http://* | https://*)
    id=$(printf '%s\n' "$target" | sed -n 's|.*/s/\([0-9A-Za-z-][0-9A-Za-z-]*\).*|\1|p')
    [ -n "$id" ] || { echo "pair: no session id in $target (a chi web URL ends in #/s/<id>)" >&2; exit 2; }
    ;;
  *) id=$target ;;
esac

# Without a socket chi can reach, chi can't send here: a pairing with no
# address (Claude's answers only).
if [ -n "$via" ] && [ -z "$inbox" ]; then
  $chi peer pair claude "$id" --from "Claude Code in $PWD (on another machine)" >/dev/null
  ask=$chi
  [ "$via" = chi ] || ask="CHI_REMOTE=$remote $chi"
  printf '%s\n' "pair: chi is on $remote, so chi can't send to this Claude session (claude_send needs its socket on chi's machine): paired with chi $id for answers only. Answer chi with $ask peer say claude $id; chi's replies reach you only when the user relays them (or asks you to run $ask send --wait $id)"
  printf '%s\n' "pair: to let chi send here too, forward this Claude's socket to $remote with ssh -R and pair again with --inbox-socket (the chi-peer skill's \"chi on another machine over SSH\")"
  exit 0
fi

if [ -z "$inbox" ]; then
  $chi peer pair claude "$id" --address "$sock" --from "Claude Code in $PWD" >/dev/null
  echo "paired with chi $id (socket $sock)"
else
  $chi peer pair claude "$id" --address "$inbox" --from "Claude Code in $PWD, over ssh (its socket $sock)" >/dev/null
  echo "paired with chi $id (socket $inbox on chi's machine, forwarded to this Claude's $sock)"
fi
